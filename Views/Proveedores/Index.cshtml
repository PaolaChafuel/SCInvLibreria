@model IEnumerable<Proveedor>
@{ ViewData["Title"] = "Proveedores"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Proveedores</h2><a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por nombre o RUC..." /></div><div class="col-auto"><button class="btn btn-outline-secondary">Buscar</button><a asp-action="Index" class="btn btn-link">Limpiar</a></div></form>
<div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Nombre</th><th>RUC / Identificación</th><th>Email</th><th>Teléfono</th><th></th></tr></thead><tbody>
@foreach(var item in Model){<tr><td>@item.Nombre</td><td>@item.Ruc</td><td>@item.Email</td><td>@item.Telefono</td><td class="text-end"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Ver</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr>}
</tbody></table></div></div>
