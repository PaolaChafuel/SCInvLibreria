@model Libro
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row"><div class="col-md-8 mb-3"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control"/><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Isbn" class="form-label"></label><input asp-for="Isbn" class="form-control"/><span asp-validation-for="Isbn" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="Autor" class="form-label"></label><input asp-for="Autor" class="form-control"/><span asp-validation-for="Autor" class="text-danger"></span></div>
<div class="row"><div class="col-md-4 mb-3"><label asp-for="Stock" class="form-label"></label><input asp-for="Stock" class="form-control"/><span asp-validation-for="Stock" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Precio" class="form-label"></label><input asp-for="Precio" class="form-control" step="0.01"/><span asp-validation-for="Precio" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="ProveedorId" class="form-label"></label><select asp-for="ProveedorId" asp-items="ViewBag.ProveedorId" class="form-select"><option value="0">-- Seleccione --</option></select><span asp-validation-for="ProveedorId" class="text-danger"></span></div></div>
