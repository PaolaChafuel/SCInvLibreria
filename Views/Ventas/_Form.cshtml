@model Venta
<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="LibroId" class="form-label"></label><select asp-for="LibroId" asp-items="ViewBag.LibroId" class="form-select" id="LibroId"><option value="0">-- Seleccione --</option></select><span asp-validation-for="LibroId" class="text-danger"></span><div class="form-text" id="stockInfo"></div></div><div class="col-md-3 mb-3"><label asp-for="Cantidad" class="form-label"></label><input asp-for="Cantidad" class="form-control"/><span asp-validation-for="Cantidad" class="text-danger"></span></div><div class="col-md-3 mb-3"><label asp-for="Fecha" class="form-label"></label><input asp-for="Fecha" class="form-control"/><span asp-validation-for="Fecha" class="text-danger"></span></div></div>
<div class="mb-3"><label asp-for="PrecioUnitario" class="form-label"></label><input asp-for="PrecioUnitario" class="form-control" step="0.01" id="PrecioUnitario"/><span asp-validation-for="PrecioUnitario" class="text-danger"></span><div class="form-text">Al seleccionar un libro se carga su precio actual; puede ajustarlo si corresponde.</div></div>
